# Copie para deploy/.env e preencha. NUNCA versione o .env.
# Gere segredos com: openssl rand -hex 32

# --- Domínio e HTTPS ---
CHATWOOT_DOMAIN=atendimento.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br
FRONTEND_URL=https://atendimento.seudominio.com.br

# --- Chatwoot ---
CHATWOOT_VERSION=latest
SECRET_KEY_BASE=
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=pt_BR
ACTIVE_STORAGE_SERVICE=local

# --- Banco e cache ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- E-mail (convites de agentes, recuperação de senha) ---
MAILER_SENDER_EMAIL=Nebula Host <atendimento@seudominio.com.br>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# --- Embedded Signup (só quando a conta for Tech Provider; docs/08 seção 2, caminho A) ---
# WHATSAPP_APP_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_CONFIGURATION_ID=
